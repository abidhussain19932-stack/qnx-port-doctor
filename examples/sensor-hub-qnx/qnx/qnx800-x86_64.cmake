# QNX 8.0 CMake toolchain file - generated by qnx-port-doctor
# Usage: source ~/qnx800/qnxsdp-env.sh
#        cmake -B build-qnx -DCMAKE_TOOLCHAIN_FILE=qnx/qnx800-x86_64.cmake
set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_VERSION 8.0.0)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

if(NOT DEFINED ENV{QNX_HOST} OR NOT DEFINED ENV{QNX_TARGET})
  message(FATAL_ERROR "Source qnxsdp-env.sh from your QNX SDP 8.0 install first")
endif()
set(QNX_HOST   $ENV{QNX_HOST})
set(QNX_TARGET $ENV{QNX_TARGET})

set(CMAKE_C_COMPILER   ${QNX_HOST}/usr/bin/qcc)
set(CMAKE_CXX_COMPILER ${QNX_HOST}/usr/bin/q++)
set(CMAKE_C_COMPILER_TARGET   gcc_ntox86_64)
set(CMAKE_CXX_COMPILER_TARGET gcc_ntox86_64_cxx)
set(CMAKE_C_FLAGS_INIT   "-Vgcc_ntox86_64 -D_QNX_SOURCE")
set(CMAKE_CXX_FLAGS_INIT "-Vgcc_ntox86_64_cxx -D_QNX_SOURCE")
set(CMAKE_AR     ${QNX_HOST}/usr/bin/ntox86_64-ar   CACHE FILEPATH "ar")
set(CMAKE_RANLIB ${QNX_HOST}/usr/bin/ntox86_64-ranlib CACHE FILEPATH "ranlib")
set(CMAKE_SYSROOT ${QNX_TARGET})
set(CMAKE_FIND_ROOT_PATH ${QNX_TARGET} ${QNX_TARGET}/x86_64)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
