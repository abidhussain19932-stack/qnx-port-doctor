# QNX 8.0 Makefile - generated by qnx-port-doctor
# Usage: source ~/qnx800/qnxsdp-env.sh && make -f Makefile.qnx ARCH=x86_64
ARCH    ?= x86_64
CC      := qcc
VARIANT_x86_64    := gcc_ntox86_64
VARIANT_aarch64le := gcc_ntoaarch64le
CFLAGS  += -V$(VARIANT_$(ARCH)) -D_QNX_SOURCE -O2 -Wall -Wextra 
LDLIBS  += -lsocket
SRCS    := src/main.c
OUT     := build-qnx/$(ARCH)
OBJS    := $(SRCS:%.c=$(OUT)/%.o)
BIN     := $(OUT)/sensor-hub

all: $(BIN)
$(BIN): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)
$(OUT)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
clean:
	rm -rf build-qnx
.PHONY: all clean
